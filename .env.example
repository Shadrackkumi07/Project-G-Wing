# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit a real .env.
# On Render, set these in the service's Environment tab instead.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Who may call THIS API
#
# Callers send: Authorization: Bearer <api-key>
#
# Preferred: store only SHA-256 hashes, so the server never holds a usable key.
# Generate a key and its hash with:  npm run keygen
# Several are allowed, comma-separated.
# ---------------------------------------------------------------------------

API_KEY_HASHES=

# ---------------------------------------------------------------------------
# ChatGPT read-only URL token
#
# This is a separate, long random token used only in:
#   /api/chatgpt/<token>/<account>?days=30
# It is never returned or logged. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ---------------------------------------------------------------------------

CHATGPT_ACCESS_TOKEN=
CHATGPT_RATE_LIMIT_MAX=30

# Convenience alternative for local development only. Plaintext keys must be at
# least 24 characters. Prefer API_KEY_HASHES in production.
# API_KEYS=

# ---------------------------------------------------------------------------
# X (Twitter) credentials — server-side only, never accepted from callers
#
# Create a project + app at https://developer.x.com, then copy the app's
# "Bearer Token" (OAuth 2.0 App-Only). Read-only access is enough.
#
# One token shared by every account below:
# ---------------------------------------------------------------------------

X_BEARER_TOKEN=

# Required. Used to AES-256-GCM encrypt per-account OAuth tokens at rest.
# Generate with: openssl rand -base64 48
CREDENTIAL_ENCRYPTION_KEY=

# One shared X developer application; each connection keeps its own user token.
X_CLIENT_ID=
X_CLIENT_SECRET=
# A separate 32+ character browser URL secret. Generate with the same command
# as CHATGPT_ACCESS_TOKEN. Used only at /auth/x/<OAUTH_SETUP_TOKEN>.
OAUTH_SETUP_TOKEN=
# Must exactly match the callback URL saved in your X Developer App settings.
# On your current Render service, use:
# https://project-g-wing.onrender.com/auth/x/callback
X_OAUTH_REDIRECT_URI=https://your-service.onrender.com/auth/x/callback
X_OAUTH_SCOPES=tweet.read users.read offline.access

# Production: set DATABASE_URL to a Neon pooled Postgres connection string.
# It takes precedence over DATA_FILE and stores the encrypted state in JSONB.
# Never commit the connection string.
DATABASE_URL=

# Local development/test fallback only. Render Free does not preserve this file.
DATA_FILE=./data/x-analytics.json
SYNC_INTERVAL_SECONDS=900
SYNC_POST_LIMIT=500

# ---------------------------------------------------------------------------
# Which X accounts to expose, one numbered slot each.
#
#   X_ACCOUNT_<n>_USERNAME      required — handle, with or without the @
#   X_ACCOUNT_<n>_ID            optional — id used in URLs (default: the handle)
#   X_ACCOUNT_<n>_LABEL         optional — display name (default: @handle)
#   X_ACCOUNT_<n>_BEARER_TOKEN  optional — overrides X_BEARER_TOKEN for this
#                                          account, for handles that belong to
#                                          a different X app
# ---------------------------------------------------------------------------

X_ACCOUNT_1_USERNAME=your_handle
X_ACCOUNT_1_ID=main
X_ACCOUNT_1_LABEL=Personal

# X_ACCOUNT_2_USERNAME=your_other_handle
# X_ACCOUNT_2_ID=brand
# X_ACCOUNT_2_LABEL=Brand
# X_ACCOUNT_2_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Transport and access control
# ---------------------------------------------------------------------------

# Reject plaintext HTTP on the /v1 endpoints. Defaults to true when
# NODE_ENV=production, false otherwise. Leave unset unless you need to override.
# REQUIRE_HTTPS=

# Read the client IP and protocol from X-Forwarded-* headers. Required on
# Render and any other platform that terminates TLS at a load balancer.
TRUST_PROXY=true

# Browser origins allowed to call the API, comma-separated. Empty means no
# browser origin is allowed, which is correct for a server-to-server API.
# CORS_ORIGINS=

# Serve the interactive docs at /docs. The OpenAPI document at /openapi.json is
# always served.
ENABLE_DOCS=true

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Upstream behaviour
# ---------------------------------------------------------------------------

X_API_BASE_URL=https://api.x.com/2
X_TIMEOUT_MS=10000

# How long an account's X data is reused before re-fetching. X's free and basic
# tiers have low rate limits, so do not set this to 0 in production.
CACHE_TTL_SECONDS=300

# Posts pulled per account to build the analytics window (5-100; X caps a
# single page at 100).
ANALYTICS_TWEET_LIMIT=100

# How many top posts by engagement to include per account.
TOP_TWEETS_COUNT=5
